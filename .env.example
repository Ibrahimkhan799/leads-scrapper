# Copy to .env (`npm run setup` does this for you).
# Default config is completely free: OpenStreetMap + DuckDuckGo. No paid keys.

DATABASE_URL="postgresql://leadintel:leadintel@localhost:5432/leadintel"
REDIS_URL="redis://127.0.0.1:6379"

# Application
APP_SECRET="dev-secret-change-in-production-leadintel-2026"
NEXT_PUBLIC_APP_NAME="LeadIntel"

# false = real OpenStreetMap businesses (default, free)
# true  = fake catalog only (not useful for real outreach)
USE_MOCK_PROVIDERS="false"

# true  = jobs run inside Next.js (default). Redis is optional.
# false = enqueue to Redis/BullMQ (also needs `npm run dev:all` or `npm run worker`)
INLINE_JOBS="true"

# Discovery — all optional. Leave blank for the free stack.
GOOGLE_PLACES_API_KEY=""
SEARCH_API_KEY=""
SEARCH_API_URL=""
APIFY_TOKEN=""
OUTSCRAPER_API_KEY=""

# Optional Overpass / Nominatim mirrors
# OVERPASS_URL="https://overpass-api.de/api/interpreter"
# NOMINATIM_URL="https://nominatim.openstreetmap.org/search"

# AI (optional, paid if you use OpenAI)
AI_ENABLED="false"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Crawler (Cheerio is free and default; Playwright is optional)
PLAYWRIGHT_ENABLED="false"
CRAWL_MAX_PAGES="10"
CRAWL_MAX_DEPTH="2"
CRAWL_TIMEOUT_MS="15000"
CRAWL_DELAY_MS="1000"
CRAWL_MAX_CONCURRENT="3"
CRAWL_MAX_RETRIES="3"
